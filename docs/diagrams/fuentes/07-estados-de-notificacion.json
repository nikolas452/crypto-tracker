{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Estados de una notificación en la cola de correos (outbox)",
    "output": "07-estados-de-notificacion.html",
    "viewBox": [
      1030,
      660
    ],
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Ciclo de envío"
    },
    {
      "id": "terminal",
      "label": "Estados finales"
    }
  ],
  "states": [
    {
      "id": "pending",
      "type": "start",
      "label": "pending",
      "sublabel": "en la cola",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "sending",
      "type": "active",
      "label": "sending",
      "sublabel": "un worker la tomó",
      "lane": "main",
      "col": 2,
      "step": "02"
    },
    {
      "id": "sent",
      "type": "success",
      "label": "sent",
      "sublabel": "SMTP lo aceptó",
      "lane": "main",
      "col": 4,
      "step": "03"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "failed",
      "sublabel": "no se pudo enviar",
      "lane": "terminal",
      "col": 0
    },
    {
      "id": "cancelled",
      "type": "neutral",
      "label": "cancelled",
      "sublabel": "ya no corresponde",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "reclamar",
      "from": "pending",
      "to": "sending",
      "label": "claimNext",
      "variant": "emphasis"
    },
    {
      "id": "enviado",
      "from": "sending",
      "to": "sent",
      "label": "SMTP acepta",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "reintento",
      "from": "sending",
      "to": "pending",
      "label": "SMTP_UNAVAILABLE: espera 1, 5, 15, 60 min",
      "variant": "dashed",
      "route": "top-channel"
    },
    {
      "id": "rechazo",
      "from": "sending",
      "to": "failed",
      "label": "SMTP_REJECTED o 5 intentos",
      "variant": "security",
      "route": "drop"
    },
    {
      "id": "cancelar",
      "from": "sending",
      "to": "cancelled",
      "label": "usuario inexistente",
      "variant": "security",
      "labelDy": 34
    },
    {
      "id": "reintento-admin",
      "from": "failed",
      "to": "pending",
      "label": "retry de admin",
      "variant": "dashed",
      "route": "left-channel"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Cómo se crea",
      "items": [
        "Nace pending en la transacción de la alerta",
        "Clave única alertId:triggerCount"
      ]
    },
    {
      "dot": "amber",
      "title": "Reintentos",
      "items": [
        "Máximo 5 intentos, con espera y variación de 10 %",
        "Un lock de más de 10 min vuelve a pending o failed"
      ]
    },
    {
      "dot": "rose",
      "title": "Cancelación y retry",
      "items": [
        "Borrar la alerta cancela sus pending",
        "El admin devuelve failed a pending"
      ]
    }
  ]
}
