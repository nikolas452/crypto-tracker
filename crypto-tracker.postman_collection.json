    {
      "name": "Auth (Firebase)",
      "item": [
        {
          "name": "Sign up (create test user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signUp returned an idToken', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().idToken).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('idToken', pm.response.json().idToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "{{authApiBaseUrl}}/accounts:signUp?key={{firebaseWebApiKey}}",
              "host": ["{{authApiBaseUrl}}"],
              "path": ["accounts:signUp"],
              "query": [{ "key": "key", "value": "{{firebaseWebApiKey}}" }]
            },
            "description": "Calls Firebase's Identity Toolkit REST API directly (the same one `npm run auth:create-test-user` and `npm run auth:token` use) — no CLI needed. Run once per email: a second run fails with EMAIL_EXISTS, use 'Sign in' instead. Saves the ID token into the `idToken` collection variable. Equivalent script: `npm run auth:create-test-user -- --email {{testEmail}} --password {{testPassword}}`."
          }
        },
        {
          "name": "Sign in (get ID token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signIn returned an idToken', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().idToken).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('idToken', pm.response.json().idToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "{{authApiBaseUrl}}/accounts:signInWithPassword?key={{firebaseWebApiKey}}",
              "host": ["{{authApiBaseUrl}}"],
              "path": ["accounts:signInWithPassword"],
              "query": [{ "key": "key", "value": "{{firebaseWebApiKey}}" }]
            },
            "description": "Use once the account already exists. Saves the ID token into `idToken`. Equivalent script: `npm run auth:token -- --email {{testEmail}} --password {{testPassword}}`. ID tokens expire after 1 hour - rerun this to refresh `idToken`."
          }
        },
        {
          "name": "Sign up as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('adminIdToken', pm.response.json().idToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "{{authApiBaseUrl}}/accounts:signUp?key={{firebaseWebApiKey}}",
              "host": ["{{authApiBaseUrl}}"],
              "path": ["accounts:signUp"],
              "query": [{ "key": "key", "value": "{{firebaseWebApiKey}}" }]
            },
            "description": "Creates the Firebase account for the future admin and saves its token into `adminIdToken`. This alone does NOT grant the admin role — it only exists in Firebase, not yet in Mongo. Next: call 'Me > Get my profile' with `adminIdToken` once to provision it, then from a terminal run `npm run user:set-role -- --email {{adminEmail}} --role admin` (or skip both steps with `npm run auth:create-test-user -- --email {{adminEmail}} --password {{adminPassword}} --admin`, then just use 'Sign in as admin' below to get the token)."
          }
        },
        {
          "name": "Sign in as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('adminIdToken', pm.response.json().idToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "{{authApiBaseUrl}}/accounts:signInWithPassword?key={{firebaseWebApiKey}}",
              "host": ["{{authApiBaseUrl}}"],
              "path": ["accounts:signInWithPassword"],
              "query": [{ "key": "key", "value": "{{firebaseWebApiKey}}" }]
            },
            "description": "Refreshes `adminIdToken` once the admin account exists in Firebase and already has role=admin in Mongo (see 'Sign up as admin')."
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Get my profile - no token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "401 UNAUTHENTICATED - no Authorization header."
          }
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "E3-4: first call with a valid token for an unknown uid just-in-time provisions the Mongo profile and returns { data: { id, email, emailVerified, displayName, role, createdAt } }. Run 'Auth (Firebase) > Sign up' or 'Sign in' first to get `idToken`."
          }
        },
        {
          "name": "Update display name",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{idToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Nico\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "E3-8: the only editable field. `displayName: null` clears it."
          }
        },
        {
          "name": "Update display name - empty body -> 400",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{idToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "400 VALIDATION_ERROR - at least one field is required, and displayName is the only one that exists."
          }
        },
        {
          "name": "Update role -> 400 (not editable here)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{idToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "E3-8: 400 VALIDATION_ERROR - the schema is .strict(), role is not an accepted field. Privilege escalation via PATCH /me is impossible by design (design.md)."
          }
        },
        {
          "name": "Delete my account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me"] },
            "description": "E3-11: 204, deletes the Mongo document only. Uses checkRevoked: true (destructive operation). The Firebase account itself is untouched - calling 'Get my profile' again with the same (still-valid) token re-provisions a brand-new empty profile. See README."
          }
        }
      ]
    },
    {
      "name": "Admin - Job Runs",
      "item": [
        {
          "name": "List job runs - no token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/job-runs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "job-runs"]
            },
            "description": "401 UNAUTHENTICATED - requireAuth runs before requireRole."
          }
        },
        {
          "name": "List job runs - old X-Admin-Key header -> 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Admin-Key", "value": "whatever-this-no-longer-exists" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/job-runs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "job-runs"]
            },
            "description": "E3-10: the retired X-Admin-Key header is not read anywhere anymore - with no Authorization header this is still just a 401, same as any other unauthenticated request."
          }
        },
        {
          "name": "List job runs - non-admin token -> 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{idToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/job-runs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "job-runs"]
            },
            "description": "E3-9: a valid token whose Mongo role is still the default 'user' -> 403 FORBIDDEN."
          }
        },
        {
          "name": "List job runs (filtered by status)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminIdToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/job-runs?status=success,partial&limit=10",
              "host": ["{{baseUrl}}"],
