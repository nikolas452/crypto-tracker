{
  "name": "crypto-tracker",
  "version": "1.0.0",
  "description": "Backend crypto tracker: price polling job, REST read API, Firebase auth, watchlists and email alerts.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongoose": "9.10.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/supertest": "7.2.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "mongodb-memory-server": "11.2.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.7",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "@vitest/coverage-v8": "5.0.1"
  }
}
