# Environment: development | test | production. Defaults to "development".
NODE_ENV=development

# TCP port the API listens on (1-65535). Defaults to 3000.
PORT=3000

# MongoDB connection string. Required. Must start with mongodb:// or mongodb+srv://.
# Local Docker Compose Mongo:
MONGODB_URI=
# Atlas example (do not commit real credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Database name used on the MongoDB connection. Defaults to "crypto_tracker".
MONGODB_DB_NAME=crypto_tracker

# pino log level: fatal | error | warn | info | debug | trace | silent. Defaults to "info".
LOG_LEVEL=info

# Milliseconds allowed for graceful shutdown before forcing exit 1. Must be >= 1000. Defaults to 10000.
SHUTDOWN_TIMEOUT_MS=10000


# --- primer-job: CoinGecko client (worker/scripts only) ---
# CoinGecko Demo plan API key. Required by the worker, seed:coins and
# job:poll-prices entrypoints (not by the API process). Never commit a real key.
COINGECKO_API_KEY=

# CoinGecko API base URL. Demo-key root, not pro-api. Defaults to the value below.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Per-attempt HTTP timeout in ms for CoinGecko calls. Defaults to 10000.
COINGECKO_TIMEOUT_MS=10000

# Max retries for retryable CoinGecko failures (0-5). Defaults to 2.
COINGECKO_MAX_RETRIES=2

# Max coin ids per CoinGecko batch call (1-250). Defaults to 50.
COINGECKO_MAX_IDS_PER_CALL=50

# --- primer-job: poll-prices job & worker ---
# Cron expression (5 fields, UTC) for the poll-prices job. Defaults to every 10 minutes.
POLL_PRICES_CRON=*/10 * * * *

# Whether the worker also runs the job once immediately on startup. Defaults to true.
POLL_PRICES_RUN_ON_START=true

# Days to retain price_snapshots documents before they expire (TTL). Empty = no expiration. Defaults to 90.
SNAPSHOT_RETENTION_DAYS=90

# Days to retain job_runs documents before they expire (TTL). Defaults to 30.
JOB_RUNS_RETENTION_DAYS=30

# Minutes after which a JobRun still 'running' is considered stale and recovered as failed on worker startup. Defaults to 15.
STALE_RUN_THRESHOLD_MIN=15

# Milliseconds the worker waits for an in-progress run to finish during shutdown before forcing exit 1. Defaults to 30000.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- api-rest: rate limiting, proxy trust, admin surface ---
# Number of reverse-proxy hops to trust for the client IP used by the rate
# limiter (Express "trust proxy"). Defaults to 0 in development/test, 1 in
# production (e.g. one hop behind Render's proxy).
TRUST_PROXY=0

# Max requests per client IP allowed per RATE_LIMIT_WINDOW_MIN on /api before
# a 429 RATE_LIMITED response. /health and /health/ready are exempt. Defaults to 300.
RATE_LIMIT_MAX=300

# Rate-limit window, in minutes. Defaults to 15.
RATE_LIMIT_WINDOW_MIN=15

# Minutes since the last successful/partial poll-prices run before
# GET /api/v1/status reports stale: true. Defaults to 30.
STALE_POLL_THRESHOLD_MIN=30

# Shared secret required in the X-Admin-Key header to reach /api/v1/admin/*.
# Optional: when unset, every admin route responds 404. Provisional protection,
# replaced by real auth in a later stage. Minimum 32 characters. Generate with:
#   openssl rand -hex 32
ADMIN_API_KEY=
