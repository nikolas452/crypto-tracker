# Environment: development | test | production. Defaults to "development".
NODE_ENV=development

# TCP port the API listens on (1-65535). Defaults to 3000.
PORT=3000

# MongoDB connection string. Required. Must start with mongodb:// or mongodb+srv://.
# Local Docker Compose Mongo:
MONGODB_URI=
# Atlas example (do not commit real credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Database name used on the MongoDB connection. Defaults to "crypto_tracker".
MONGODB_DB_NAME=crypto_tracker

# Maximum size of the Mongoose connection pool, so a deployment never
# approaches the cluster's connection limit (e.g. 500 on an Atlas M0
# cluster). Defaults to 10.
MONGODB_MAX_POOL_SIZE=10

# pino log level: fatal | error | warn | info | debug | trace | silent. Defaults to "info".
LOG_LEVEL=info

# Milliseconds allowed for graceful shutdown before forcing exit 1. Must be >= 1000. Defaults to 10000.
SHUTDOWN_TIMEOUT_MS=10000


# --- primer-job: CoinGecko client (worker/scripts only) ---
# CoinGecko Demo plan API key. Required by every entrypoint that can touch
# CoinGecko: the worker, seed:coins, job:poll-prices, and (since watchlists)
# the API itself, whose admin coin endpoints call CoinGecko to validate
# coingeckoId values. Never commit a real key.
COINGECKO_API_KEY=

# CoinGecko API base URL. Demo-key root, not pro-api. Defaults to the value below.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Per-attempt HTTP timeout in ms for CoinGecko calls. Defaults to 10000.
COINGECKO_TIMEOUT_MS=10000

# Max retries for retryable CoinGecko failures (0-5). Defaults to 2.
COINGECKO_MAX_RETRIES=2

# Max coin ids per CoinGecko batch call (1-250). Defaults to 50.
COINGECKO_MAX_IDS_PER_CALL=50

# Whether GET /health/ready includes an optional coingecko check. Disabled by
# default: a CoinGecko outage should never take the API out of rotation.
# Defaults to false.
COINGECKO_READINESS_ENABLED=false

# --- primer-job: poll-prices job & worker ---
# Cron expression (5 fields, UTC) for the poll-prices job. Defaults to every 10 minutes.
POLL_PRICES_CRON=*/10 * * * *

# Whether the worker also runs the job once immediately on startup. Defaults to true.
POLL_PRICES_RUN_ON_START=true

# Days to retain price_snapshots documents before they expire (TTL). Empty = no expiration. Defaults to 90.
SNAPSHOT_RETENTION_DAYS=90

# Days to retain job_runs documents before they expire (TTL). Defaults to 30.
JOB_RUNS_RETENTION_DAYS=30

# Minutes after which a JobRun still 'running' is considered stale and recovered as failed on worker startup. Defaults to 15.
STALE_RUN_THRESHOLD_MIN=15

# Milliseconds the worker waits for an in-progress run to finish during shutdown before forcing exit 1. Defaults to 30000.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- api-rest: rate limiting, proxy trust, admin surface ---
# Number of reverse-proxy hops to trust for the client IP used by the rate
# limiter (Express "trust proxy"). Defaults to 0 in development/test.
# REQUIRED and must be >= 1 when NODE_ENV=production (e.g. 1, one hop behind
# Render's proxy) — production has no silent default, see
# src/config/env.ts's production validation.
TRUST_PROXY=0

# Max requests per client IP allowed per RATE_LIMIT_WINDOW_MIN on /api before
# a 429 RATE_LIMITED response. /health and /health/ready are exempt. Defaults to 300.
RATE_LIMIT_MAX=300

# Rate-limit window, in minutes. Defaults to 15.
RATE_LIMIT_WINDOW_MIN=15

# Minutes since the last successful/partial poll-prices run before
# GET /api/v1/status reports stale: true. Defaults to 30.
STALE_POLL_THRESHOLD_MIN=30

# Firebase project id (service account). Required unless FIREBASE_AUTH_EMULATOR_HOST
# is set. Always REQUIRED when NODE_ENV=production, emulator or not.
FIREBASE_PROJECT_ID=

# Firebase service account client email. Required unless FIREBASE_AUTH_EMULATOR_HOST
# is set. Always REQUIRED when NODE_ENV=production, emulator or not.
FIREBASE_CLIENT_EMAIL=

# Firebase service account private key (PEM). SECRET — never commit a real value.
# Required unless FIREBASE_AUTH_EMULATOR_HOST is set. Always REQUIRED when
# NODE_ENV=production, emulator or not.
FIREBASE_PRIVATE_KEY=

# Firebase Web API key, used only by the auth:token dev script. Optional.
# FORBIDDEN when NODE_ENV=production (dev-script-only variable).
FIREBASE_WEB_API_KEY=

# Firebase Auth emulator host (e.g. 127.0.0.1:9099). Dev only — the process
# refuses to start if this is set while NODE_ENV=production.
FIREBASE_AUTH_EMULATOR_HOST=

# Max requests per authenticated uid per minute. Defaults to 120.
USER_RATE_LIMIT_PER_MIN=120

# Minutes before lastSeenAt is refreshed on an authenticated request. Defaults to 5.
LAST_SEEN_THROTTLE_MIN=5

# --- watchlists: per-user item cap ---
# Max number of watchlist items a single user can hold. Defaults to 50.
WATCHLIST_MAX_ITEMS=50

# --- alertas-email: SMTP, mail template and alert/notification jobs ---
# SMTP host. Optional at the schema level, but required by the worker
# (assertSmtpCredentials) together with MAIL_FROM — the API process never
# sends mail, so it never needs it. Local Mailpit (see docker-compose.yml):
SMTP_HOST=localhost

# SMTP port. 465 selects implicit TLS; anything else does not. Defaults to
# 587. Mailpit listens on 1025.
SMTP_PORT=1025

# SMTP auth, if the provider needs it. Mailpit needs neither — left unset.
# SMTP_USER=
# SMTP_PASS=

# "From" address on every outgoing email. Required by the worker together
# with SMTP_HOST. Stays a documented placeholder: choosing a production
# sender, a domain and SPF/DKIM are explicitly out of scope for this project.
MAIL_FROM=alerts@crypto-tracker.local

# IANA timezone shown as the local reference time in an alert email, next to
# the UTC timestamp that's always included too. Defaults to
# America/Argentina/Buenos_Aires.
MAIL_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires

# Max notifications the send-notifications job sends per run (per-minute
# cap); the remainder stays pending for the next run. Defaults to 30.
MAIL_MAX_PER_MINUTE=30

# Per-user cap on alerts in armed+triggered status. Defaults to 20.
ALERTS_MAX_ACTIVE=20

# Cron expression (5 fields, UTC) for the send-notifications job. Defaults to
# every minute.
SEND_NOTIFICATIONS_CRON=* * * * *

# Max notifications claimed per send-notifications run. Defaults to 20.
NOTIFY_BATCH_SIZE=20

# Attempts allowed before a transient send failure becomes permanently
# failed. Defaults to 5.
NOTIFY_MAX_ATTEMPTS=5

# Minutes before a notification stuck in "sending" (its worker died mid-send)
# is recovered by the next run. Defaults to 10.
NOTIFY_LOCK_TIMEOUT_MIN=10

# Days to retain notifications documents before they expire (TTL). Defaults
# to 90.
NOTIFICATIONS_RETENTION_DAYS=90

# --- agenda: scheduler (replaces node-cron) ---
# Scheduler backend. Only "agenda" is supported today; documented as a
# future extension point. Defaults to "agenda".
SCHEDULER=agenda

# How often Agenda polls the agenda_jobs collection for due work. Introduces
# scheduling latency up to this value. Defaults to "10 seconds".
AGENDA_PROCESS_EVERY=10 seconds

# Max jobs Agenda processes concurrently in this process, across all job
# names. Defaults to 5.
AGENDA_MAX_CONCURRENCY=5

# Days a finished non-recurring agenda_jobs document (created by
# agenda.now()) is kept before the maintenance job prunes it. Defaults to 7.
AGENDA_ONE_OFF_RETENTION_DAYS=7

# Cron expression (5 fields, UTC) for the daily maintenance job. Defaults to
# 03:15 UTC.
MAINTENANCE_CRON=15 3 * * *

# Lease TTL in milliseconds for poll-prices (src/lib/lease-lock.ts), so a
# dead holder cannot block the resource forever. Defaults to 300000 (5 min).
POLL_LOCK_TTL_MS=300000

# Extra retries allowed after a transient poll-prices failure before giving
# up. Defaults to 1.
POLL_MAX_JOB_RETRIES=1