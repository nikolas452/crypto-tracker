# Only secrets and credentials live here. Every non-sensitive setting (ports,
# crons, limits, timeouts, retention) is a constant in src/config/constants.ts.

# MongoDB connection string. Required. Must start with mongodb:// or mongodb+srv://.
# Atlas example (do not commit real credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# CoinGecko Demo plan API key. Required by every entrypoint that can touch
# CoinGecko: the worker, seed:coins, job:poll-prices, and the API itself, whose
# admin coin endpoints call CoinGecko to validate coingeckoId values. Never
# commit a real key.
COINGECKO_API_KEY=

# Firebase project id (service account). Required unless FIREBASE_AUTH_EMULATOR_HOST is set.
FIREBASE_PROJECT_ID=

# Firebase service account client email. Required unless FIREBASE_AUTH_EMULATOR_HOST is set.
FIREBASE_CLIENT_EMAIL=

# Firebase service account private key (PEM). SECRET - never commit a real value.
# Required unless FIREBASE_AUTH_EMULATOR_HOST is set.
FIREBASE_PRIVATE_KEY=

# Firebase Web API key, used only by the auth:token dev script. Optional.
FIREBASE_WEB_API_KEY=

# SMTP auth, if the provider needs it. Local Mailpit needs neither - leave unset.
# SMTP_USER=
# SMTP_PASS=
